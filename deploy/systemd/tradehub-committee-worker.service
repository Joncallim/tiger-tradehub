[Unit]
Description=TradeHub bounded committee model worker (drives issued committee work)
Documentation=https://github.com/Joncallim/tiger-tradehub/blob/main/deploy/README.md
After=tradehub-research.service
Wants=tradehub-research.service

[Service]
Type=oneshot
# Runs as root because the model runner CLI on this host needs the Hermes install
# under /var/lib/hermes (provider credentials, 0700 root:root), and this host already
# invokes model CLIs as root (Hermes cron jobs, the health watch). The worker holds
# NO trading authority: it opens the research DB read-only, submits assessments only
# through the authenticated committee API (whose router owns every retry, escalation
# and scoring decision), and writes only its own state file in the research dir.
User=root
WorkingDirectory=/opt/tiger-tradehub
EnvironmentFile=/etc/tradehub/research.env
# The worker is an ACTUATOR: it fetches the pinned artifact over MCP, submits
# through the authenticated committee API, and lets the scorer/finalizer advance.
# It exits immediately when the current cycle has no outstanding work, and it never
# touches the historical backlog. Spend/work bounds live in the module defaults
# (max-runs 4, max-model-calls 12, max-seconds 840) and can be overridden here or
# on the command line.
ExecStart=/opt/tiger-tradehub/.venv/bin/python -m tradehub_research.ops.committee_worker
# The runner CLI is named absolutely: a systemd service does not inherit the login
# PATH, and a missing runner would look like an unready provider.
Environment=RESEARCH_COMMITTEE_WORKER_HERMES=/opt/hermes/venv/bin/hermes
# HERMES_HOME selects the estate's Hermes profile. Without it a clean service
# environment resolves a different config and the runner fails with
# "Unknown provider 'cheaperinference'" -- observed on the first automated tick.
Environment=HERMES_HOME=/var/lib/hermes
Nice=10
# Outer wall: the module's own --max-seconds bound is 840s, so a wedged invocation
# is killed well before the next timer tick.
TimeoutStartSec=1020

[Install]
WantedBy=multi-user.target
