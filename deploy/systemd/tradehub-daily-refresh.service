[Unit]
Description=TradeHub daily market/evidence refresh (ops)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jon
Group=jon
WorkingDirectory=/home/jon/tiger-tradehub-main
EnvironmentFile=/etc/tradehub/research.env
Environment=TRADEHUB_RESEARCH_DIR=/home/jon/tiger-tradehub-main/data/research
ExecStart=/home/jon/tiger-tradehub-main/.venv/bin/python -m tradehub_research.ops.daily_refresh
# Bound by the Tiingo quota (45/hr); a quota-exhausted tick exits 2 and is
# retried at the next tick -- never duplicated, always resumable.
