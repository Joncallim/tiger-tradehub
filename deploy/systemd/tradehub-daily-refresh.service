[Unit]
Description=TradeHub daily market/evidence refresh (ops)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradehub-research
Group=tradehub-research
WorkingDirectory=/opt/tiger-tradehub
EnvironmentFile=/etc/tradehub/research.env
Environment=TRADEHUB_RESEARCH_DIR=/var/lib/tradehub-research
ExecStart=/opt/tiger-tradehub/.venv/bin/python -m tradehub_research.ops.daily_refresh
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradehub-research
InaccessiblePaths=/etc/tradehub/execution.env /etc/tradehub/autonomy.env /etc/tradehub/tiger_private_key.pk8
