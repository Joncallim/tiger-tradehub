[Unit]
Description=TradeHub autonomous PAPER runner (after the M/W/F research cycle)

[Service]
Type=oneshot
User=jon
Group=jon
WorkingDirectory=/home/jon/tiger-tradehub-main
EnvironmentFile=/etc/tradehub/research.env
Environment=TRADEHUB_RESEARCH_DIR=/home/jon/tiger-tradehub-main/data/research
ExecStart=/home/jon/tiger-tradehub-main/.venv/bin/python -m tradehub.autonomy.runner
# The runner is the deterministic autonomous-PAPER actor: zero eligible
# proposals => zero orders; every write goes through the guarded execution
# API with autonomous=True (kill-switch enforced at the broker boundary).
