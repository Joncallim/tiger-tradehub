[Unit]
Description=TradeHub autonomous PAPER runner (after the M/W/F research cycle)

[Service]
Type=oneshot
User=tradehub-autonomy
Group=tradehub-autonomy
WorkingDirectory=/opt/tiger-tradehub
EnvironmentFile=/etc/tradehub/autonomy.env
Environment=TRADEHUB_RESEARCH_DIR=/var/lib/tradehub-research
ExecStart=/opt/tiger-tradehub/.venv/bin/python -m tradehub.autonomy.runner
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradehub-research/autonomy /var/lib/tradehub/autonomy/proposals
ReadOnlyPaths=/var/lib/tradehub/autonomy/kill_switch /var/lib/tradehub/autonomy/authority
# Hard boundary: the autonomy identity reads the narrow research-written
# authority projection and the sanitized ledger, and can NEVER open the
# research databases.
InaccessiblePaths=/etc/tradehub/execution.env /etc/tradehub/research.env /var/lib/tradehub-research/research.db /var/lib/tradehub-research/experiment.db /var/lib/tradehub-research/validation_replay.db -/etc/tradehub/tiger_private_key.pk8
# The runner is the deterministic autonomous-PAPER actor: zero eligible
# proposals => zero orders; every write goes through the guarded execution
# API with autonomous=True (kill-switch enforced at the broker boundary).
