[Unit]
Description=TradeHub temporary stale-data recovery refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jon
Group=jon
WorkingDirectory=/opt/tiger-tradehub
EnvironmentFile=/etc/tradehub/research.env
Environment=TRADEHUB_RESEARCH_DIR=/home/jon/tiger-tradehub-main/data/research
ExecStart=/opt/tiger-tradehub/.venv/bin/python -m tradehub_research.ops.daily_refresh
# Temporary operational recovery only: same bounded 40-request code path as
# the daily timer; no research cycle, scoring, or trading action is invoked.
