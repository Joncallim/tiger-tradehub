[Unit]
Description=TradeHub M/W/F research cycle (ops)
After=tradehub-daily-refresh.service

[Service]
Type=oneshot
User=tradehub-research
Group=tradehub-research
WorkingDirectory=/opt/tiger-tradehub
EnvironmentFile=/etc/tradehub/research.env
Environment=TRADEHUB_RESEARCH_DIR=/var/lib/tradehub-research
ExecStart=/opt/tiger-tradehub/.venv/bin/python -m tradehub_research.ops.research_cycle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tradehub-research /var/lib/tradehub/autonomy/proposals
InaccessiblePaths=/var/lib/tradehub/autonomy/kill_switch
InaccessiblePaths=/etc/tradehub/execution.env /etc/tradehub/autonomy.env -/etc/tradehub/tiger_private_key.pk8

[Install]
WantedBy=multi-user.target
