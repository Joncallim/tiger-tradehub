[Unit]
Description=TradeHub autonomy trigger on newly exported PAPER envelopes
Documentation=file:/opt/tiger-tradehub/deploy/systemd/README.md

[Path]
# Event trigger: a newly exported proposal envelope starts one runner pass
# immediately, so the common case needs no polling at all.
PathExistsGlob=/var/lib/tradehub/autonomy/proposals/*.json
Unit=tradehub-paper-autonomy.service

[Install]
WantedBy=paths.target
