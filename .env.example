# API token required by REST, MCP, and Telegram clients.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Empty, placeholder, and short tokens are refused at startup.
TRADEHUB_API_TOKEN=change-me

# Defaults are intentionally non-destructive.
TRADEHUB_DRY_RUN=true
TRADEHUB_BIND_HOST=127.0.0.1
TRADEHUB_PORT=8787

# Guardrails. Empty TRADEHUB_SYMBOL_ALLOWLIST means no allowlist restriction.
# Release 1 supports USD-denominated limit orders only.
TRADEHUB_SYMBOL_ALLOWLIST=AAPL,MSFT,VOO
TRADEHUB_MAX_NOTIONAL_USD=1000
TRADEHUB_MAX_QUANTITY=100
TRADEHUB_CONFIRMATION_TTL_SECONDS=300

# Tiger OpenAPI credentials. Prefer a paper account while testing.
TIGEROPEN_TIGER_ID=
TIGEROPEN_ACCOUNT=
TIGEROPEN_PRIVATE_KEY_PATH=
# License required by your broker region (e.g. TBSG for Tiger Brokers Singapore).
TIGEROPEN_LICENSE=
# Alternative to TIGEROPEN_PRIVATE_KEY_PATH. Use a single-line escaped value or shell multiline env.
TIGEROPEN_PRIVATE_KEY=
TIGEROPEN_SANDBOX=false

# Acceptance (FA-05) paper-write authority. Defaults false. Before any
# broker write the acceptance runner must ALSO prove broker-reported
# accountType=PAPER from Tiger account information and a non-marketable
# limit; this flag alone grants nothing.
TRADEHUB_ACCEPTANCE_PAPER_WRITE=false

# Telegram integration. Leave blank to disable.
# When TELEGRAM_BOT_TOKEN is set, TELEGRAM_ALLOWED_CHAT_IDS must contain at least one chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
